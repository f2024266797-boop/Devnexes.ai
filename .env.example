# ═══════════════════════════════════════════════════════════════════
# Devnexes AI Production Environment Configuration
# ═══════════════════════════════════════════════════════════════════

# ── Groq API Keys (Text, Chat, Planning & Synthesis) ──────────────
# 3 API Keys for Automatic Failover: If Key #1 hits rate/token limits (HTTP 429),
# the system automatically switches to Key #2 and Key #3 seamlessly.
# Get free keys at: https://console.groq.com/keys
GROQ_API_KEY_1=gsk_your_primary_groq_api_key_here
GROQ_API_KEY_2=gsk_your_second_fallback_groq_key_here
GROQ_API_KEY_3=gsk_your_third_fallback_groq_key_here

# Groq Flagship Model (Default: qwen/qwen3.8-27b)
GROQ_MODEL=qwen/qwen3.8-27b

# ── Google Gemini API Keys (Code Generation & Canvas) ──────────────
# Dedicated for 100% of Code Generation, Interactive HTML Canvas & Artifacts.
# 3 API Keys for Automatic Failover on Quota Exceeded / Rate Limits.
# Get keys at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY_1=AIzaSy_your_primary_gemini_api_key_here
GEMINI_API_KEY_2=AIzaSy_your_second_fallback_gemini_key_here
GEMINI_API_KEY_3=AIzaSy_your_third_fallback_gemini_key_here

# Gemini Model (Default: gemini-3-flash-preview)
GEMINI_MODEL=gemini-3-flash-preview

# ── Prioritized Real-Time Web Search ──────────────────────────────
# Priority 1: Tavily AI Search Key (Get at: https://app.tavily.com)
TAVILY_API_KEY=tvly-your_tavily_key_here

# Priority 2: Brave Search Key (Get at: https://brave.com/search/api/)
BRAVE_API_KEY=your_brave_api_key_here

# Priority 3: DuckDuckGo & Wikipedia (Open-Source, Automatic, No key needed)
